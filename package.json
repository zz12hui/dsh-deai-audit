{
  "name": "dsh-local-deai-audit",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "DSH 工具插件：文案去 AI 味审计（六维评分 + 逐句打标 + 改法），对话中直接调用 deai_audit / deai_audit_config。",
  "author": "zz12hui",
  "license": "MIT",
  "homepage": "https://github.com/zz12hui/dsh-deai-audit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zz12hui/dsh-deai-audit.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "ai-writing",
    "chinese",
    "copywriting",
    "audit"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "config/deai-config.json",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
