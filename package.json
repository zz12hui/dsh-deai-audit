{
  "name": "dsh-local-deai-audit",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "DSH 内置的文案去 AI 味审计工具（对话中直接调用）",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "config/deai-config.json", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
