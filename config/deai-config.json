{
  "version": 2,
  "name": "deai-audit 配置",
  "description": "GUI 与命令行共用。改完导出为 JSON，替换本文件即可。",
  "bands": [
    { "max": 15, "label": "很自然", "action": "可交付" },
    { "max": 30, "label": "基本自然", "action": "挑 1-2 处改" },
    { "max": 50, "label": "有模板感，建议再改", "action": "结构性改，别只换词" },
    { "max": 100, "label": "一眼 AI，必须重写", "action": "重写，别修补" }
  ],
  "common": {
    "templateWords": [
      "赋能", "闭环", "抓手", "沉淀", "打造", "助力", "驱动", "洞察", "打法",
      "矩阵", "体系", "生态", "全域", "全链路", "端到端", "一站式", "全方位",
      "极致", "深度", "高效", "精准", "持续", "有效", "完善", "丰富", "显著",
      "大幅", "进一步", "全面提升", "全面覆盖", "深度融合", "有力支撑"
    ],
    "connectors": [
      "首先", "其次", "再次", "此外", "同时", "从而", "因此", "综上",
      "值得注意的是", "不仅", "而且", "一方面", "另一方面", "总而言之"
    ],
    "colloquial": [
      "说白了", "其实", "老实说", "讲真", "问题是", "关键是", "反过来",
      "你会发现", "举个例子", "比如", "我自己", "我见过", "上周", "去年",
      "说实话", "你想想", "结果呢", "以前", "现在", "原来", "后来", "最后",
      "直接", "当时", "那天"
    ],
    "concretePattern": "[一二三四五六七八九十百千万几]+(个|天|周|月|年|小时|分钟|次|人|家|万|块|元|点|下|条|页)|\\d|GIS|Dify|Claude|Codex|PMP|Axure|XMind|MES|SaaS|IMIS|CRM|APP|AI|Agent|分局|总队|甲方|厂商|客户|驻场|联调|验收|上线|排期|拆|培训|运维|交付|算法|接口|链路|测试|需求|合同|投标|浦东|杨浦|长宁|知识库|多模态|智能体|工作流|原型|PRD|Prompt|RAG|模型|产品|团队|版本",
    "parallelStarts": ["赋能", "打造", "构建", "推动", "助力", "实现", "提升", "优化", "通过", "基于", "主导", "聚焦", "围绕", "依托", "借助", "深耕", "布局", "整合", "确保", "坚持", "加强"],
    "verbStarts": ["负责", "交付", "完成", "组织", "对接", "带", "做", "管", "跟", "写", "从", "累计", "最多", "曾", "主导", "参与", "把", "对", "在", "用", "给", "到", "进"],
    "skillSections": ["技能与证书", "研发管理方法"],
    "maxSentenceLength": 50,
    "triadPattern": "[^，。；：]{2,6}、[^，。；：]{2,6}、[^，。；：]{2,6}",
    "uniformBulletThreshold": 0.22,
    "uniformPenalty": 35,
    "humanPenaltyScale": 300,
    "repeatNgram": 6,
    "repeatMinCount": 4,
    "repeatWeight": 4,
    "repeatCap": 60
  },
  "genres": [
    {
      "id": "resume",
      "name": "简历 / 述职",
      "weights": { "struct": 30, "vague": 20, "syntax": 15, "concrete": 25, "repeat": 10, "human": 0 },
      "cliche": ["赋能", "闭环", "抓手", "沉淀", "打造", "助力", "驱动", "矩阵", "全链路", "全面提升"],
      "note": "最怕标签式结构和口号；数字、系统名、角色是硬通货"
    },
    {
      "id": "report",
      "name": "方案 / 汇报",
      "weights": { "struct": 25, "vague": 25, "syntax": 15, "concrete": 20, "repeat": 10, "human": 5 },
      "cliche": ["高度重视", "持续推进", "不断完善", "进一步加强", "全面提升", "扎实推进", "有力保障", "切实", "确保", "有效落实", "深度融合", "协同推进"],
      "note": "最怕正确废话和总-分-总；要写清做什么、谁来做、边界在哪"
    },
    {
      "id": "article",
      "name": "公众号 / 知乎",
      "weights": { "struct": 20, "vague": 25, "syntax": 20, "concrete": 15, "repeat": 5, "human": 15 },
      "cliche": ["综上所述", "总而言之", "值得注意的是", "不难发现", "可以看出", "在这个时代", "随着时代的发展", "毫无疑问", "众所周知"],
      "note": "最怕首先其次综上、每段三句、没有观点；要有立场和例子"
    },
    {
      "id": "marketing",
      "name": "营销 / 种草",
      "weights": { "struct": 15, "vague": 25, "syntax": 20, "concrete": 20, "repeat": 5, "human": 15 },
      "cliche": ["全新升级", "极致体验", "品质之选", "不容错过", "一站式", "全方位", "打造", "赋能", "助力", "颠覆", "重磅"],
      "note": "最怕假大空形容词；要场景、细节、反差"
    },
    {
      "id": "bid",
      "name": "标书 / 商务",
      "weights": { "struct": 20, "vague": 30, "syntax": 15, "concrete": 20, "repeat": 10, "human": 5 },
      "cliche": ["我方将", "严格遵守", "全面满足", "确保质量", "规范管理", "优质高效", "切实履行", "高度重视", "高效推进", "有力保障"],
      "note": "最怕排比和承诺空转；要可执行的承诺和验收口径"
    },
    {
      "id": "email",
      "name": "邮件 / 通知",
      "weights": { "struct": 25, "vague": 25, "syntax": 20, "concrete": 20, "repeat": 5, "human": 5 },
      "cliche": ["敬请知悉", "特此通知", "现将有关事项通知如下", "如有疑问", "请您查阅", "感谢您的支持与配合"],
      "note": "最怕模板套话；一句话说清目的和要对方做什么"
    }
  ],
  "defaultGenre": "resume"
}
